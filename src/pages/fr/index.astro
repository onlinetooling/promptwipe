import Tool from '../../components/Tool.astro';
import Base from '../../layouts/Base.astro';
---
<Base
  lang="fr"
  heading="Supprimer les métadonnées d’une image IA"
  title="Supprimer les métadonnées d’une image IA — PromptWipe"
  description={'Voyez et supprimez le prompt, le workflow ComfyUI, le C2PA et les données EXIF / GPS cachés dans vos images IA. Gratuit, dans votre navigateur\u00a0: rien n’est envoyé.'}
>
  <p class="lead">
    PromptWipe montre ce que contient une image IA — prompt, seed, modèle, workflow ComfyUI, Content Credentials
    (C2PA), EXIF et position GPS — puis le retire sans toucher aux pixels. Tout se passe dans votre navigateur&nbsp;:
    l’image n’est jamais envoyée. Il ne retire pas les filigranes invisibles comme SynthID.
  </p>
  <Tool lang="fr" />
</Base>
