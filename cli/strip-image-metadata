#!/usr/bin/env bash
# Strip every metadata block from images (AI-generated or not):
# EXIF, XMP, IPTC, ICC profiles, comments, C2PA / JUMBF manifests, and PNG
# text chunks written by generators (Stable Diffusion "parameters",
# ComfyUI "prompt" / "workflow", "Software", ...).
#
# How: ImageMagick decodes the pixels and writes a brand-new file. Nothing
# from the original container survives (unknown chunks, trailing bytes
# included). "-strip" also stops ImageMagick from writing its own date,
# time, colour and text chunks, and "-orient undefined" stops its private
# PNG "orNT" chunk, so nothing is added either. The EXIF orientation is
# applied to the pixels first so the image keeps its displayed orientation.
#
# PNG / WebP lossless / GIF: pixel-exact. JPEG / WebP lossy: re-encoded at
# the quality ImageMagick estimates from the source (negligible loss).
#
# Usage:
#   strip-image-metadata FILE...          -> FILE.clean.EXT next to each file
#   strip-image-metadata -i FILE...       -> replace each file in place
#   strip-image-metadata -o DIR FILE...   -> write cleaned files into DIR
set -euo pipefail

# Byte patterns that betray leftover metadata in the output file.
LEFTOVER_RE='Exif|http://ns\.adobe\.com|c2pa|jumb|caBX|tEXt|iTXt|zTXt|eXIf|iCCP|tIME|orNT|parameters|workflow'

usage() {
  cat <<'EOF'
Supprime toutes les métadonnées d'images (EXIF, XMP, IPTC, ICC, C2PA,
paramètres de génération IA) sans en ajouter.

Usage :
  strip-image-metadata FICHIER...           crée FICHIER.clean.EXT à côté
  strip-image-metadata -i FICHIER...        remplace le fichier d'origine
  strip-image-metadata -o DOSSIER FICHIER...  écrit les copies dans DOSSIER
EOF
  exit "${1:-0}"
}

die() { echo "Erreur : $*" >&2; exit 1; }

command -v magick >/dev/null || die "ImageMagick 7 (commande « magick ») est introuvable."

in_place=0
out_dir=''
while getopts ':io:h' opt; do
  case "$opt" in
    i) in_place=1 ;;
    o) out_dir=$OPTARG ;;
    h) usage 0 ;;
    *) usage 1 ;;
  esac
done
shift $((OPTIND - 1))
[ $# -gt 0 ] || usage 1
[ "$in_place" -eq 1 ] && [ -n "$out_dir" ] && die "-i et -o ne se combinent pas."
[ -z "$out_dir" ] || mkdir -p -- "$out_dir"

# A bare relative name like "msl:x.png" would be read by ImageMagick as a
# coder prefix; anchoring it with "./" forces a plain file path.
anchor() { case "$1" in /*) printf '%s' "$1" ;; *) printf './%s' "$1" ;; esac; }

# Format from the file's first bytes, never from ImageMagick's own sniffing:
# a file named .png that really holds SVG / MVG / MSL could otherwise make
# ImageMagick read local files or URLs into the "cleaned" image. Only these
# four raster formats are accepted, and the coder is then named explicitly.
sniff() {
  local hex
  hex=$(LC_ALL=C head -c 12 "$1" | od -An -v -tx1 | tr -d ' \n')
  case "$hex" in
    89504e470d0a1a0a*)           echo PNG ;;
    ffd8ff*)                     echo JPEG ;;
    474946383761*|474946383961*) echo GIF ;;
    52494646????????57454250)    echo WEBP ;;
    *) return 1 ;;
  esac
}

# Permission bits of the source file (symlinks followed; GNU stat, then BSD /
# macOS stat), so the cleaned file is never more readable than the original.
mode_of() { stat -L -c %a "$1" 2>/dev/null || stat -L -f %Lp "$1" 2>/dev/null; }

tmp=''
trap '[ -z "$tmp" ] || rm -f -- "$tmp"' EXIT

status=0
for src in "$@"; do
  if [ ! -f "$src" ]; then
    echo "Ignoré (fichier introuvable) : $src" >&2; status=1; continue
  fi
  # In place on a symlink would replace the link and leave the target, with
  # its metadata, untouched.
  if [ "$in_place" -eq 1 ] && [ -L "$src" ]; then
    echo "Ignoré (lien symbolique, utilisez le fichier réel avec -i) : $src" >&2; status=1; continue
  fi
  src_path=$(anchor "$src")

  # Format from the magic bytes, used as an explicit input and output coder.
  if ! fmt=$(sniff "$src_path"); then
    echo "Ignoré (format non pris en charge : PNG, JPEG, WebP ou GIF seulement) : $src" >&2
    status=1; continue
  fi

  base=$(basename -- "$src")
  case "$base" in
    *.*) stem=${base%.*}; ext=.${base##*.} ;;
    *)   stem=$base;      ext='' ;;
  esac

  if [ "$in_place" -eq 1 ]; then
    dest=$src
  elif [ -n "$out_dir" ]; then
    dest=$out_dir/$base
  else
    dest=$(dirname -- "$src")/$stem.clean$ext
  fi

  # Write to a temp file in the destination directory, then move it, so a
  # failed run never leaves a half-written or truncated image behind.
  tmp=$(mktemp "$(anchor "$(dirname -- "$dest")")/.strip-XXXXXX")
  if ! magick "$fmt:$src_path" -auto-orient -orient undefined -strip \
        "$fmt:$tmp"; then
    rm -f -- "$tmp"
    echo "Échec du nettoyage : $src" >&2; status=1; continue
  fi
  # mktemp creates the file as 0600; widen it only to the source's mode,
  # never beyond 0666 minus the umask (no execute or special bits).
  mode=$(mode_of "$src_path") || mode=''
  case "$mode" in
    ''|*[!0-7]*) ;;
    *) chmod "$(printf '%o' $((8#$mode & 8#666 & ~8#$(umask))))" "$tmp" ;;
  esac
  mv -f -- "$tmp" "$dest"
  tmp=''

  if LC_ALL=C grep -aqE "$LEFTOVER_RE" -- "$dest"; then
    echo "Attention : motif de métadonnée encore présent dans $dest (à vérifier)." >&2
    status=1
  else
    echo "OK : $dest"
  fi
done
exit "$status"
